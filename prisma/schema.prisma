generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  legalName            String?
  taxPin               String?
  currency             String                  @default("KES")
  country              String                  @default("KE")
  timezone             String                  @default("Africa/Nairobi")
  logoUrl              String?
  phone                String?
  email                String?
  address              String?
  businessType         String?
  settings             Json                    @default("{}")
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  auditLogs            AuditLog[]
  batches              Batch[]
  branches             Branch[]
  brands               Brand[]
  categories           Category[]
  customers            Customer[]
  etimsConfiguration   EtimsConfiguration?
  etimsInvoices        EtimsInvoice[]
  etimsSubmissions     EtimsSubmission[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  inventoryItems       InventoryItem[]
  invoiceActivities    InvoiceActivity[]
  invoicePayments      InvoicePayment[]
  invoices             Invoice[]
  mpesaPaymentIntents  MpesaPaymentIntent[]
  notificationSettings NotificationSetting[]
  paymentAccounts      PaymentAccount[]
  paymentProviderCfgs  PaymentProviderConfig[]
  productVariants      ProductVariant[]
  products             Product[]
  purchaseOrders       PurchaseOrder[]
  purchasePayments     PurchasePayment[]
  purchases            Purchase[]
  receiptSettings      ReceiptSettings?
  registerAssignments  RegisterAssignment[]
  roles                Role[]
  sales                Sale[]
  stockCounts          StockCount[]
  stockTransfers       StockTransfer[]
  subscription         Subscription?
  suppliers            Supplier[]
  taxRates             TaxRate[]
  users                UserOrganization[]

  @@map("organizations")
}

model Branch {
  id                  String               @id @default(cuid())
  organizationId      String
  name                String
  code                String
  address             String?
  phone               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashSessions        CashSession[]
  etimsInvoices       EtimsInvoice[]
  expenses            Expense[]
  mpesaPaymentIntents MpesaPaymentIntent[]
  paymentAccounts     PaymentAccount[]
  purchaseOrders      PurchaseOrder[]
  purchases           Purchase[]
  registers           Register[]
  sales               Sale[]
  transfersFrom       StockTransfer[]      @relation("TransferFromBranch")
  transfersTo         StockTransfer[]      @relation("TransferToBranch")
  userBranches        UserBranch[]
  warehouses          Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Warehouse {
  id                 String              @id @default(cuid())
  organizationId     String
  branchId           String
  name               String
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  batches            Batch[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  purchases          Purchase[]
  stockCounts        StockCount[]
  transfersFrom      StockTransfer[]     @relation("TransferFromWarehouse")
  transfersTo        StockTransfer[]     @relation("TransferToWarehouse")
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@map("warehouses")
}

model Register {
  id           String               @id @default(cuid())
  branchId     String
  name         String
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  cashSessions CashSession[]
  assignments  RegisterAssignment[]
  credentials  RegisterCredential?
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([branchId])
  @@map("registers")
}

model RegisterCredential {
  id           String   @id @default(cuid())
  registerId   String   @unique
  terminalCode String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  register     Register @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([registerId])
  @@map("register_credentials")
}

model User {
  id                  String                   @id @default(cuid())
  name                String
  email               String                   @unique
  passwordHash        String
  phone               String?
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean                  @default(false)
  twoFactorSecret     String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  auditLogs           AuditLog[]
  cashSessions        CashSession[]            @relation("CashSessionUser")
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  registerAssignments RegisterAssignment[]
  salesCreated        Sale[]                   @relation("SaleCashier")
  sessions            Session[]
  branches            UserBranch[]
  organizations       UserOrganization[]

  @@map("users")
}

model PlatformAdmin {
  id                String                       @id @default(cuid())
  name              String
  email             String                       @unique
  passwordHash      String
  role              PlatformAdminRole            @default(ADMIN)
  isActive          Boolean                      @default(true)
  mustResetPassword Boolean                      @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  sessions          AdminSession[]
  approvals         Subscription[]               @relation("SubscriptionApprovedBy")
  invitations       PlatformAdminInvitation[]
  passwordResets    PlatformAdminPasswordReset[]
}

model AdminSession {
  id        String        @id @default(cuid())
  adminId   String
  tokenHash String        @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime      @default(now())
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model PlatformAdminInvitation {
  id             String              @id @default(cuid())
  adminId        String?
  name           String
  email          String
  role           PlatformAdminRole
  tokenHash      String              @unique
  expiresAt      DateTime
  usedAt         DateTime?
  expiredAt      DateTime?
  revokedAt      DateTime?
  deliveryStatus SecurityEmailStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  admin          PlatformAdmin?      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([email, createdAt])
  @@index([expiresAt, usedAt, revokedAt])
  @@map("platform_admin_invitations")
}

model PlatformAdminPasswordReset {
  id             String              @id @default(cuid())
  adminId        String
  tokenHash      String              @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  deliveryStatus SecurityEmailStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  admin          PlatformAdmin       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([expiresAt, usedAt, revokedAt])
  @@map("platform_admin_password_resets")
}

model SecurityEvent {
  id            String   @id @default(cuid())
  action        String
  actorAdminId  String?
  targetAdminId String?
  targetUserId  String?
  ipAddress     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([targetAdminId, createdAt])
  @@index([action, createdAt])
  @@map("security_events")
}

model AuthRateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  hits            Int

  @@index([windowStartedAt])
  @@map("auth_rate_limit_buckets")
}

model Inquiry {
  id                 String                    @id @default(cuid())
  submissionKey      String                    @unique
  name               String
  businessName       String
  phone              String
  phoneDigits        String
  email              String
  businessType       String?
  numberOfLocations  String?
  currentSystem      String?
  subject            String
  productOrService   String?
  message            String
  productId          String?
  productUrl         String?
  status             InquiryStatus             @default(NEW)
  internalNotes      String?
  ipHash             String?
  notificationStatus InquiryNotificationStatus @default(PENDING)
  notificationSentAt DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([phone, createdAt])
  @@index([phoneDigits, createdAt])
  @@index([email, createdAt])
  @@map("inquiries")
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  isOwner        Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model RegisterAssignment {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  registerId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  register       Register     @relation(fields: [registerId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, registerId])
  @@index([registerId])
  @@map("register_assignments")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  organizationId String?
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id             String              @id @default(cuid())
  userId         String
  tokenHash      String              @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  deliveryStatus SecurityEmailStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Role {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isSystem       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  permissions    RolePermission[]
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    UserOrganization[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  group String
  label String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@index([organizationId])
  @@map("categories")
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@index([organizationId])
  @@map("brands")
}

model Product {
  id                String            @id @default(cuid())
  organizationId    String
  categoryId        String?
  brandId           String?
  primarySupplierId String?
  name              String
  description       String?
  type              ProductType       @default(STOCKED)
  unit              String            @default("pc")
  imageUrl          String?
  isActive          Boolean           @default(true)
  trackExpiry       Boolean           @default(false)
  trackSerial       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bundleItems       BundleItem[]      @relation("BundleParent")
  partOfBundles     BundleItem[]      @relation("BundleComponent")
  invoiceItems      InvoiceItem[]
  suppliers         ProductSupplier[]
  variants          ProductVariant[]
  brand             Brand?            @relation(fields: [brandId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primarySupplier   Supplier?         @relation(fields: [primarySupplierId], references: [id])

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String
  name               String
  attributes         Json                @default("{}")
  costPrice          Decimal             @db.Decimal(14, 2)
  sellingPrice       Decimal             @db.Decimal(14, 2)
  wholesalePrice     Decimal?            @db.Decimal(14, 2)
  taxRateId          String?
  minStock           Decimal             @default(0) @db.Decimal(14, 3)
  reorderLevel       Decimal             @default(0) @db.Decimal(14, 3)
  maxStock           Decimal?            @db.Decimal(14, 3)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizationId     String
  batches            Batch[]
  bundleComponentOf  BundleItem[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  barcodes           ProductBarcode[]
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRate            TaxRate?            @relation(fields: [taxRateId], references: [id])
  purchaseItems      PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([organizationId])
  @@map("product_variants")
}

model ProductBarcode {
  id        String         @id @default(cuid())
  variantId String
  barcode   String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("product_barcodes")
}

model BundleItem {
  id                 String          @id @default(cuid())
  bundleProductId    String
  componentProductId String
  componentVariantId String?
  quantity           Decimal         @db.Decimal(14, 3)
  bundleProduct      Product         @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct   Product         @relation("BundleComponent", fields: [componentProductId], references: [id])
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])

  @@map("bundle_items")
}

model TaxRate {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  rate           Decimal          @db.Decimal(6, 3)
  isDefault      Boolean          @default(false)
  isActive       Boolean          @default(true)
  variants       ProductVariant[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tax_rates")
}

model Supplier {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  taxPin         String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  productLinks   ProductSupplier[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  purchases      Purchase[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("suppliers")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  supplierSku String?
  costPrice   Decimal? @db.Decimal(14, 2)
  isPreferred Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model Purchase {
  id                    String                  @id @default(cuid())
  organizationId        String
  branchId              String
  warehouseId           String
  supplierId            String
  purchaseNumber        String
  supplierInvoiceNumber String?
  receivingStatus       PurchaseReceivingStatus @default(RECEIVED)
  paymentStatus         PurchasePaymentStatus   @default(PENDING)
  purchaseDate          DateTime
  subtotal              Decimal                 @db.Decimal(14, 2)
  discountTotal         Decimal                 @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal                 @default(0) @db.Decimal(14, 2)
  total                 Decimal                 @db.Decimal(14, 2)
  paidOn                DateTime?
  createdById           String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  items                 PurchaseItem[]
  payments              PurchasePayment[]
  branch                Branch                  @relation(fields: [branchId], references: [id])
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier              Supplier                @relation(fields: [supplierId], references: [id])
  warehouse             Warehouse               @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  variantId  String
  quantity   Decimal        @db.Decimal(14, 3)
  unitCost   Decimal        @db.Decimal(14, 2)
  discount   Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal        @default(0) @db.Decimal(14, 2)
  total      Decimal        @db.Decimal(14, 2)
  batchId    String?
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

model PurchasePayment {
  id             String       @id @default(cuid())
  organizationId String
  purchaseId     String
  amount         Decimal      @db.Decimal(14, 2)
  method         String
  reference      String?
  notes          String?
  paymentDate    DateTime     @default(now())
  createdById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase       Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([organizationId, purchaseId])
  @@map("purchase_payments")
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  organizationId       String
  branchId             String
  warehouseId          String
  supplierId           String
  poNumber             String
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal             @default(0) @db.Decimal(14, 2)
  total                Decimal             @default(0) @db.Decimal(14, 2)
  expectedDeliveryDate DateTime?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  goodsReceipts        GoodsReceipt[]
  items                PurchaseOrderItem[]
  branch               Branch              @relation(fields: [branchId], references: [id])
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id])
  invoices             SupplierInvoice[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Decimal            @db.Decimal(14, 3)
  quantityReceived Decimal            @default(0) @db.Decimal(14, 3)
  unitCost         Decimal            @db.Decimal(14, 2)
  discount         Decimal            @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal            @default(0) @db.Decimal(14, 2)
  total            Decimal            @db.Decimal(14, 2)
  receiptItems     GoodsReceiptItem[]
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant     @relation(fields: [variantId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  purchaseOrderId String
  receivedById    String
  receivedAt      DateTime           @default(now())
  notes           String?
  items           GoodsReceiptItem[]
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  quantityReceived    Decimal           @db.Decimal(14, 3)
  batchNumber         String?
  expiryDate          DateTime?
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id              String            @id @default(cuid())
  organizationId  String
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String
  amount          Decimal           @db.Decimal(14, 2)
  amountPaid      Decimal           @default(0) @db.Decimal(14, 2)
  dueDate         DateTime?
  status          String            @default("UNPAID")
  createdAt       DateTime          @default(now())
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  payments        SupplierPayment[]

  @@index([organizationId, status])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id             String           @id @default(cuid())
  organizationId String
  supplierId     String
  invoiceId      String?
  amount         Decimal          @db.Decimal(14, 2)
  method         String
  reference      String?
  paidAt         DateTime         @default(now())
  createdById    String
  invoice        SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  supplier       Supplier         @relation(fields: [supplierId], references: [id])

  @@index([organizationId, supplierId])
  @@map("supplier_payments")
}

model InventoryItem {
  id             String         @id @default(cuid())
  warehouseId    String
  variantId      String
  batchId        String?
  quantity       Decimal        @default(0) @db.Decimal(14, 3)
  averageCost    Decimal        @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime       @updatedAt
  organizationId String
  batch          Batch?         @relation(fields: [batchId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
